# Copy this file to .env and fill in real values from your Supabase project
# (Project Settings → Database, and Project Settings → API). .env is
# git-ignored; never commit real credentials.

# App runtime connection — Supabase's pooled/pgbouncer connection string
# (port 6543). Used by lib/db.ts via the @prisma/adapter-pg driver adapter.
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"

# Migrations/introspection connection — Supabase's direct connection string
# (port 5432, no pooler). Used only by prisma7.config.ts / the Prisma CLI.
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Supabase Auth — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[ANON_KEY]"

# Supabase service role key — server-only, bypasses RLS via the Supabase Admin
# API. Not needed for prisma/seed.ts (that connects directly over Postgres via
# DIRECT_URL, which already bypasses RLS). Reserved for admin-only operations
# Prisma can't do itself — e.g. deleting the auth.users row as part of account
# deletion (docs/PRD.md). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY="[SERVICE_ROLE_KEY]"
