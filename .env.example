# Copy this file to .env and fill in real values from your Supabase project's
# "Connect" dialog → ORM tab → Prisma (and Project Settings → API for the
# keys below). .env is git-ignored; never commit real credentials.

# App runtime connection — Supabase's transaction-mode pooler (port 6543).
# Used by lib/db.ts via the @prisma/adapter-pg driver adapter.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[POOLER_HOST]:6543/postgres?pgbouncer=true"

# Migrations/introspection connection — Supabase's session-mode pooler
# (port 5432). Not a raw unpooled connection like plain Postgres setups use;
# Supabase's session pooler still supports what `prisma migrate` needs
# (prepared statements, advisory locks) unlike the transaction pooler above.
# Used only by prisma7.config.ts / the Prisma CLI.
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[POOLER_HOST]:5432/postgres"

# Supabase Auth — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[ANON_KEY]"

# Base URL of this app, used to build the password-reset redirect link sent
# in the reset email (app/(auth)/reset-password/actions.ts). Must also be
# added to Supabase's Authentication → URL Configuration → Redirect URLs
# allowlist (as "<this value>/reset-password/confirm"), or the reset link
# will fail with a redirect-not-allowed error.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Supabase service role key — server-only, bypasses RLS via the Supabase Admin
# API. Not needed for prisma/seed.ts (that connects directly over Postgres via
# DIRECT_URL, which already bypasses RLS). Reserved for admin-only operations
# Prisma can't do itself — e.g. deleting the auth.users row as part of account
# deletion (docs/PRD.md). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY="[SERVICE_ROLE_KEY]"
