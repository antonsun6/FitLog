# Copy this file to .env.test to run the test suite (`pnpm test`).
#
# Points at a disposable LOCAL Postgres database, never the real Supabase
# project — tests truncate tables between runs, so pointing this at anything
# with real data would destroy it. See CLAUDE.md "Testing" for full setup:
#   brew install postgresql@14 && brew services start postgresql@14
#   createdb -h 127.0.0.1 -p <port> fitlogger_test
#   DATABASE_URL=... DIRECT_URL=... pnpm exec prisma migrate deploy
#
# Adjust host/port/user for your local Postgres install.
DATABASE_URL="postgresql://localhost:5432/fitlogger_test"
DIRECT_URL="postgresql://localhost:5432/fitlogger_test"
